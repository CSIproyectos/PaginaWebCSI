---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import task2Img from '../img/task-csi/task2.png';
import task3Img from '../img/task-csi/task3.jpg';
import task9Img from '../img/task-csi/task9.jpg';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Task CSI',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, On-Premise, Cloud',
  description:
    'Suite de gestión empresarial en tiempo real con despliegue flexible On-Premise, Híbrido o en la Nube. Sincronización instantánea, tableros Kanban y analíticas de rendimiento.',
  keywords:
    'software de gestión de proyectos, gestión de tareas empresarial, Kanban en tiempo real, plataforma on-premise, ERP ligero México, alternativa a Asana Jira Trello, integración Zoho CRM',
  featureList: [
    'Tableros Kanban interactivos',
    'Sincronización en tiempo real',
    'Reportes y analíticas de bloqueos',
    'Despliegue en la nube, híbrido u on-premise',
    'Integración con Zoho CRM',
    'Seguridad RBAC y Active Directory/LDAP',
  ],
  offers: {
    '@type': 'Offer',
    priceCurrency: 'MXN',
    availability: 'https://schema.org/InStock',
  },
  brand: {
    '@type': 'Organization',
    name: 'Proyectos CSI',
  },
};
---

<Layout
  title="Task CSI - Software de Gestión de Proyectos en Tiempo Real | Nube y On-Premise"
  description="Task CSI: software de gestión de proyectos con tableros Kanban, sincronización en tiempo real y reportes automáticos de cumplimiento. Despliegue en la nube, híbrido u on-premise en México."
  schema={schema}
>
  <section class="relative overflow-hidden bg-gray-900 text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-900 to-blue-950"></div>
    <div class="absolute inset-0 bg-grid-white/[0.05]"></div>

    <div class="container-custom relative z-10 py-24 md:py-28 lg:py-32">
      <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr]">
        <div class="mx-auto max-w-3xl text-center lg:mx-0 lg:text-left">
          <p class="mb-6 inline-flex items-center rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur-sm">
            Lanzamiento 2026 · Proyectos CSI
          </p>
          <h1 class="mb-6 text-4xl font-bold leading-tight text-white drop-shadow-lg md:text-5xl lg:text-6xl">
            Task CSI: gestión de proyectos en tiempo real, sin importar dónde vivan tus datos
          </h1>
          <p class="mx-auto mb-10 max-w-2xl text-xl text-gray-300 lg:mx-0">
            Tableros Kanban, sincronización instantánea y analíticas de rendimiento. Elige desplegarla en la nube, de forma híbrida o 100% en tu propia red local: tú tienes el control.
          </p>
          <div class="flex flex-col justify-center gap-4 sm:flex-row lg:justify-start">
            <a href="/contacto/" class="inline-flex items-center justify-center rounded-full bg-white px-8 py-4 font-semibold text-gray-900 transition-colors hover:bg-gray-100">
              Solicitar Demo Gratuita
            </a>
            <a href="#ediciones" class="inline-flex items-center justify-center rounded-full border border-white/30 px-8 py-4 font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/10">
              Ver Ediciones y Precios
            </a>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-[620px] lg:ml-auto">
          <div class="relative z-10">
            <div class="overflow-hidden rounded-2xl border border-white/10 shadow-lg">
              <Image
                src={task3Img}
                alt="Task CSI mostrando una vista de trabajo con tablero y métricas"
                class="h-auto w-full"
                loading="eager"
              />
            </div>
            <div class="-mt-10 ml-auto max-w-[78%] overflow-hidden rounded-2xl border border-white/10 bg-white shadow-2xl ring-1 ring-black/10">
              <Image
                src={task9Img}
                alt="Task CSI mostrando una segunda vista de la portada"
                class="h-auto w-full"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <div class="lg:col-span-2">
          <div class="mx-auto mt-4 max-w-5xl rounded-2xl border border-white/10 bg-[#0f1b33] p-4 shadow-2xl md:p-5">
            <div class="grid gap-4 md:grid-cols-3">
              <div class="rounded-xl bg-white/10 px-5 py-4 text-white">
                <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-300">Tablero Kanban</p>
                <p class="text-base font-semibold leading-snug">Flujo visual por columnas y prioridades</p>
              </div>
              <div class="rounded-xl bg-white/10 px-5 py-4 text-white">
                <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-300">Tiempo Real</p>
                <p class="text-base font-semibold leading-snug">Sincronización instantánea en toda la red</p>
              </div>
              <div class="rounded-xl bg-white/10 px-5 py-4 text-white">
                <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-300">Despliegue</p>
                <p class="text-base font-semibold leading-snug">Nube, híbrido u on-premise</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h2 class="mb-4 text-gray-900">Los problemas invisibles del software en la nube tradicional</h2>
        <p class="text-lg text-gray-600">El SaaS convencional impone fricciones que las operaciones exigentes no se pueden permitir</p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-10">
        <div class="text-center">
          <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-10 w-10 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18.364 5.636a9 9 0 010 12.728m-3.536-3.536a4 4 0 010-5.656m-1.414 8.9L7.05 5.05a7 7 0 00-1.414 8.9" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 3l18 18" />
            </svg>
          </div>
          <h3 class="mb-4 text-xl font-bold text-gray-900">Parálisis por desconexión</h3>
          <p class="leading-relaxed text-gray-600">Si la fibra o el enlace satelital falla, la operación de campo se detiene y nadie puede ver sus tareas.</p>
        </div>

        <div class="text-center">
          <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-10 w-10 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="mb-4 text-xl font-bold text-gray-900">El efecto embudo de latencia</h3>
          <p class="leading-relaxed text-gray-600">Enviar archivos a servidores externos se traduce en horas de trabajo perdidas por empleado.</p>
        </div>

        <div class="text-center">
          <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-10 w-10 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="mb-4 text-xl font-bold text-gray-900">Fuga de datos estratégicos</h3>
          <p class="leading-relaxed text-gray-600">Almacenar bitácoras y planes confidenciales en papel o en ecxel vulnera políticas de cumplimiento y perdida de información.</p>
        </div>

        <div class="text-center">
          <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-10 w-10 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="mb-4 text-xl font-bold text-gray-900">Presupuesto inestable</h3>
          <p class="leading-relaxed text-gray-600">El cobro recurrente por usuario y en dólares castiga el crecimiento de tu equipo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="mb-6 inline-flex items-center rounded-full bg-gray-200 px-4 py-2 text-sm font-semibold text-gray-900">Gestión Visual</p>
          <h2 class="mb-6 text-3xl font-bold text-gray-900 md:text-4xl">Tableros Kanban interactivos para todo tu flujo de trabajo</h2>
          <div class="space-y-4 text-lg leading-relaxed text-gray-700">
            <p>Mapea el flujo de cualquier proyecto o proceso en columnas: Por Hacer, En Desarrollo, En Revisión, Completado.</p>
            <p>Si un supervisor marca una tarea como bloqueada o añade un comentario, la actualización se refleja al instante en la pantalla del resto del equipo.</p>
          </div>
        </div>
        <div class="space-y-6">
          <div class="rounded-2xl border border-gray-200 bg-gradient-to-br from-gray-900 to-blue-950 p-8 text-white shadow-xl">
            <div class="grid gap-4 md:grid-cols-3">
              <div class="rounded-xl bg-white/10 p-4">
                <p class="text-sm text-gray-300">Por Hacer</p>
                <p class="mt-2 text-sm">5 tareas</p>
              </div>
              <div class="rounded-xl bg-white/10 p-4">
                <p class="text-sm text-gray-300">En Proceso</p>
                <p class="mt-2 text-sm">3 tareas</p>
              </div>
              <div class="rounded-xl bg-white/10 p-4">
                <p class="text-sm text-gray-300">Completado</p>
                <p class="mt-2 text-sm">18 tareas</p>
              </div>
            </div>
          </div>
          <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xl">
            <Image
              src={task2Img}
              alt="Vista de Task CSI mostrando el panel principal"
              class="h-auto w-full"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reportes / Analíticas -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="order-2 rounded-2xl border border-gray-200 bg-gray-50 p-8 shadow-xl lg:order-1">
          <div class="mb-6 grid grid-cols-2 gap-4 md:grid-cols-4">
            <div class="rounded-xl bg-blue-50 p-4 text-center">
              <p class="text-2xl font-bold text-blue-700">14</p>
              <p class="text-xs text-gray-600">Proyectos Activos</p>
            </div>
            <div class="rounded-xl bg-purple-50 p-4 text-center">
              <p class="text-2xl font-bold text-purple-700">6</p>
              <p class="text-xs text-gray-600">Usuarios Activos</p>
            </div>
            <div class="rounded-xl bg-cyan-50 p-4 text-center">
              <p class="text-2xl font-bold text-cyan-700">144</p>
              <p class="text-xs text-gray-600">Tareas Totales</p>
            </div>
            <div class="rounded-xl bg-green-50 p-4 text-center">
              <p class="text-2xl font-bold text-green-700">49.3%</p>
              <p class="text-xs text-gray-600">Tasa de Cumplimiento</p>
            </div>
          </div>
          <div class="rounded-xl border border-gray-200 bg-white p-4">
            <p class="mb-2 text-sm font-semibold text-gray-900">Análisis de bloqueos</p>
            <p class="text-xs text-gray-600">Razón más común: <span class="font-medium text-gray-900">Esperando backend</span> · Promedio por bloqueo: <span class="font-medium text-gray-900">0.1h</span></p>
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <p class="mb-6 inline-flex items-center rounded-full bg-gray-200 px-4 py-2 text-sm font-semibold text-gray-900">Analíticas Avanzadas</p>
          <h2 class="mb-6 text-3xl font-bold text-gray-900 md:text-4xl">Reportes automáticos que destraban la operación</h2>
          <div class="mb-6 space-y-4 text-lg leading-relaxed text-gray-700">
            <p>Genera reportes de seguimiento semanal con tasa de cumplimiento, tareas atrasadas y un dashboard de bloqueos con el promedio de tiempo detenido por incidente.</p>
            <p>La dirección toma decisiones informadas para destrabar la operación antes de que un retraso se convierta en un problema mayor.</p>
          </div>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-gray-900"></span>
              <span>Tasa de cumplimiento y tareas completadas vs. pendientes</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-gray-900"></span>
              <span>Análisis de bloqueos con razón más común y horas perdidas</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-gray-900"></span>
              <span>Exportación en PDF y notificaciones automáticas por correo</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Casos de uso por sector -->
  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h2 class="mb-4 text-gray-900">Casos de uso por sector</h2>
        <p class="text-lg text-gray-600">Los escenarios de mayor impacto para operaciones logísticas, portuarias, industriales y corporativas en México</p>
      </div>

      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">
        <div class="rounded-2xl bg-white p-8 shadow-sm">
          <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-8 w-8 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="mb-3 text-center text-xl font-bold text-gray-900">Operadores Portuarios y Terminales</h3>
          <p class="mb-4 leading-relaxed text-gray-700">Inspectores de patio operan con tablets en Wi-Fi local, adjuntando fotos y checklists de hasta 10 MB por tarjeta.</p>
          <p class="text-sm font-semibold text-gray-900">Beneficio: la carga y descarga de barcos sigue su curso 100% offline si falla la fibra exterior.</p>
        </div>

        <div class="rounded-2xl bg-white p-8 shadow-sm">
          <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-8 w-8 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h3 class="mb-3 text-center text-xl font-bold text-gray-900">Plantas Industriales y Manufactura</h3>
          <p class="mb-4 leading-relaxed text-gray-700">Tablero Kanban de mantenimiento preventivo y correctivo: el operario crea una tarjeta de incidente al detectar una anomalía.</p>
          <p class="text-sm font-semibold text-gray-900">Beneficio: registro automático del tiempo de respuesta ante incidentes.</p>
        </div>

        <div class="rounded-2xl bg-white p-8 shadow-sm">
          <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-8 w-8 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 6v-3a1 1 0 011-1h2a1 1 0 011 1v3" />
            </svg>
          </div>
          <h3 class="mb-3 text-center text-xl font-bold text-gray-900">Corporativos y Agencias Aduanales</h3>
          <p class="mb-4 leading-relaxed text-gray-700">Toda la suite se instala de forma web accesible desde cualquier navegador, alojada de forma exclusiva dentro del servidor web y centro de datos de tu empresa.</p>
          <p class="text-sm font-semibold text-gray-900">Beneficio: Control total y trazabilidad normativa en tu propio servidor, sin depender de terceros.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI / Comparativa de precios -->
  <section class="section-padding relative overflow-hidden bg-gray-900 text-white">
    <div class="absolute inset-0 bg-grid-white/[0.05]"></div>
    <div class="container-custom relative z-10">
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h2 class="mb-4 text-white">Deja de pagar el "impuesto SaaS"</h2>
        <p class="text-lg text-gray-300">Simulación para un equipo corporativo de 50 usuarios, comparado contra un SaaS tradicional de $500 MXN/usuario/mes</p>
      </div>

      <div class="mx-auto mb-12 grid max-w-4xl gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-8">
          <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-400">SaaS tradicional</p>
          <p class="mb-2 text-4xl font-bold">$300,000 <span class="text-lg font-normal text-gray-400">MXN/año</span></p>
          <p class="text-gray-400">Cobro recurrente por usuario, escala indefinidamente al crecer tu equipo.</p>
        </div>
        <div class="rounded-2xl bg-white p-8 text-gray-900 shadow-xl">
          <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Task CSI (Año 1)</p>
          <p class="mb-2 text-4xl font-bold">$68,000 <span class="text-lg font-normal text-gray-500">MXN</span></p>
          <p class="text-gray-600">Instalación única + póliza de soporte anual. Sin sorpresas por nuevos colaboradores.</p>
        </div>
      </div>

      <div class="flex flex-col justify-center gap-8 text-center sm:flex-row">
        <div>
          <p class="text-3xl font-bold text-green-400">78%</p>
          <p class="text-gray-300">de ahorro en el Año 1</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-green-400">84%</p>
          <p class="text-gray-300">de ahorro recurrente a partir del Año 2</p>
        </div>
      </div>
    </div>
  </section>

  <section id="ediciones" class="section-padding bg-white">
    <div class="container-custom">
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h2 class="mb-4 text-gray-900">Ediciones flexibles para cada organización</h2>
        <p class="text-lg text-gray-600">Selecciona el paquete adecuado para el volumen de tus operaciones actuales</p>
      </div>

      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-8 text-center shadow-sm">
          <h3 class="mb-3 text-xl font-bold text-gray-900">Standard</h3>
          <p class="text-gray-600">Ideal para iniciar con tablero Kanban, usuarios básicos y operación ligera.</p>
        </div>
        <div class="rounded-2xl border-2 border-gray-900 bg-white p-8 text-center shadow-lg">
          <h3 class="mb-3 text-xl font-bold text-gray-900">Pro</h3>
          <p class="text-gray-600">Para equipos que requieren reportes, control de permisos y sincronización local.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-8 text-center shadow-sm">
          <h3 class="mb-3 text-xl font-bold text-gray-900">Enterprise</h3>
          <p class="text-gray-600">Despliegue completo, integración con directorios y analíticas avanzadas.</p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/contacto/" class="inline-flex items-center justify-center rounded-full bg-gray-900 px-8 py-4 font-semibold text-white transition-colors hover:bg-gray-800">
          Solicitar Cotización por Edición
        </a>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <h2 class="mb-16 text-center text-gray-900">Preguntas Frecuentes sobre Task CSI</h2>
      <div class="mx-auto grid max-w-4xl gap-4">
        <details class="group rounded-lg bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <summary class="flex cursor-pointer list-none items-center justify-between font-bold text-lg text-gray-900">
            <span>¿Task CSI funciona en la nube y también on-premise?</span>
            <span class="transition-transform group-open:rotate-180">⌄</span>
          </summary>
          <p class="mt-4 text-gray-600">Sí, de forma totalmente flexible. Al ser una aplicación web, tu equipo solo necesita un navegador para acceder. Puedes alojarla en tu propio servidor (On-Premise), en tu nube privada o en un esquema híbrido.</p>
        </details>

        <details class="group rounded-lg bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <summary class="flex cursor-pointer list-none items-center justify-between font-bold text-lg text-gray-900">
            <span>¿Qué pasa si se cae el internet?</span>
            <span class="transition-transform group-open:rotate-180">⌄</span>
          </summary>
